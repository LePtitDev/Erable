<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Light by default, dark with the system (values-night): the WebView then reports prefers-color-scheme to the SPA. -->
  <style name="ErableTheme" parent="@android:style/Theme.DeviceDefault.Light">
    <item name="android:colorPrimary">@color/accent</item>
    <item name="android:colorAccent">@color/accent</item>
  </style>

  <!-- The system bars show the background of the SPA (color-bg in src/web/src/shared/theme/tokens.css), dark icons. -->
  <style name="ErableTheme.Web" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
    <item name="android:windowBackground">@color/web_background</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <color name="accent">#2c6a55</color>
  <color name="web_background">#f4f5f2</color>
  <color name="launcher_background">#2c6a55</color>
</resources>
