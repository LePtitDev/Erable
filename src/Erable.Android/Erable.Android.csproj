<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android application (M6-07, decision Q11): a client of Erable servers. It keeps a list of servers and shows the
    SPA of the chosen one in a WebView; nothing of the backend or of the SPA is embedded. Out of Erable.sln: building
    it needs the android workload (`dotnet workload install android`); its pure logic (Shell/) is tested by
    tests/Erable.Android.Tests. Packaged by build/publish-android.mjs (M6-08).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <!-- Not « Erable.Android »: inside it, « Android.App » would resolve to Erable.Android.App. -->
    <RootNamespace>Erable.Mobile</RootNamespace>
    <AssemblyName>Erable.Mobile</AssemblyName>
    <ApplicationId>fr.leptitdev.erable</ApplicationId>
    <ApplicationTitle>Erable</ApplicationTitle>
    <!-- versionName and versionCode; build/publish-android.mjs passes them from the release version. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- No sharing of the HTTP stack with the system proxy settings of a desktop: the Android one. -->
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <!-- Every current phone and the emulators of the CI machines. -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erable.Core\Erable.Core.csproj" />
  </ItemGroup>

</Project>
