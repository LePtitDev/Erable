{
  "openapi": "3.1.1",
  "info": {
    "title": "Erable API",
    "version": "v1"
  },
  "paths": {
    "/api/info": {
      "get": {
        "tags": [
          "erable"
        ],
        "operationId": "GetInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "post": {
        "tags": [
          "erable"
        ],
        "operationId": "CreateDesktopSession",
        "parameters": [
          {
            "name": "X-Erable-Session",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/self-test/report": {
      "post": {
        "tags": [
          "erable"
        ],
        "operationId": "ReportSelfTest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelfTestReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiInfo": {
        "required": [
          "appVersion",
          "apiVersion",
          "formatVersion",
          "mode"
        ],
        "type": "object",
        "properties": {
          "appVersion": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "formatVersion": {
            "type": "integer",
            "format": "int32"
          },
          "mode": {
            "$ref": "#/components/schemas/HostMode"
          }
        }
      },
      "HostMode": {
        "enum": [
          "desktop",
          "server"
        ],
        "type": "string"
      },
      "SelfTestReport": {
        "required": [
          "steps",
          "readyAtMs"
        ],
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SelfTestStep"
            }
          },
          "readyAtMs": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SelfTestStep": {
        "required": [
          "name",
          "ok",
          "durationMs",
          "detail"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "number",
            "format": "double"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "erable"
    }
  ]
}
