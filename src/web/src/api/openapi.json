  "components": {
    "schemas": {
      "ApiInfo": {
        "required": [
          "appVersion",
          "apiVersion",
          "formatVersion",
          "mode"
        ],
        "type": "object",
        "properties": {
          "appVersion": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "formatVersion": {
            "type": "integer",
            "format": "int32"
          },
          "mode": {
            "$ref": "#/components/schemas/HostMode"
          }
        }
      },
      "AttachmentDisplay": {
        "enum": [
          "image",
          "video",
          "audio",
          "pdf",
          "file"
        ],
        "type": "string"
      },
      "AttachmentItem": {
        "required": [
          "id",
          "pageId",
          "fileName",
          "mime",
          "size",
          "display"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "pageId": {
            "$ref": "#/components/schemas/ElementId"
          },
          "fileName": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "display": {
