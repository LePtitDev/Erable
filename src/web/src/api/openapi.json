  "components": {
    "schemas": {
      "ApiInfo": {
        "required": [
          "appVersion",
          "apiVersion",
          "formatVersion",
          "mode"
        ],
        "type": "object",
        "properties": {
          "appVersion": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "formatVersion": {
            "type": "integer",
            "format": "int32"
          },
          "mode": {
            "$ref": "#/components/schemas/HostMode"
          }
        }
      },
      "AttachmentItem": {
        "required": [
          "id",
          "pageId",
          "fileName",
          "mime",
          "size"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "pageId": {
            "$ref": "#/components/schemas/ElementId"
          },
          "fileName": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BacklinkItem": {
        "required": [
          "sourceId",
          "sourceKind",
          "sourceName",
          "path",
          "count",
          "embedded"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "$ref": "#/components/schemas/ElementId"
          },
          "sourceKind": {
            "$ref": "#/components/schemas/ElementKind"
          },
          "sourceName": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathItem"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "embedded": {
            "type": "boolean"
          }
        }
      },
      "ChildPage": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateFolderRequest": {
        "required": [
          "parentId",
          "name"
        ],
        "type": "object",
        "properties": {
          "parentId": {
            "$ref": "#/components/schemas/ElementId"
          },
          "name": {
            "type": "string"
          },
          "index": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "CreatePageRequest": {
        "required": [
          "parentId",
          "name"
        ],
        "type": "object",
        "properties": {
          "parentId": {
            "$ref": "#/components/schemas/ElementId"
          },
          "name": {
            "type": "string"
          },
          "index": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "markdown": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateProjectRequest": {
        "required": [
          "folder",
          "name",
          "contentLanguage"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "contentLanguage": {
            "type": "string"
          }
        }
      },
      "ElementDetails": {
        "required": [
          "id",
          "kind",
          "parentId",
          "name",
          "revision",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "deleted",
          "path"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "kind": {
            "$ref": "#/components/schemas/ElementKind"
          },
          "parentId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ElementId"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathItem"
            }
          }
        }
      },
      "ElementId": {
        "pattern": "^[0-9A-F]{16}$",
        "type": "string",
        "format": "element-id"
      },
      "ElementKind": {
        "enum": [
          "root",
          "folder",
          "page",
          "category",
          "propertyDefinition",
          "linkType",
          "attachment"
        ],
        "type": "string"
      },
      "FolderInspection": {
        "required": [
          "status",
          "name",
          "projectId",
          "formatVersion"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/FolderStatus"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "projectId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ElementId"
              }
            ]
          },
          "formatVersion": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "FolderStatus": {
        "enum": [
          "missing",
          "notAProject",
          "project",
          "tooNew",
          "invalid"
        ],
        "type": "string"
      },
      "HostMode": {
        "enum": [
          "desktop",
          "server"
        ],
        "type": "string"
      },
      "InspectFolderRequest": {
        "required": [
          "folder"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          }
        }
      },
      "OpenProjectRequest": {
        "required": [
          "folder"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          }
        }
      },
      "PageContent": {
        "required": [
          "markdown",
          "revision"
        ],
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PageSavedResult": {
        "required": [
          "revision",
          "updatedAt",
          "updatedBy"
        ],
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string"
          }
        }
      },
      "PageView": {
        "required": [
          "element",
          "markdown",
          "subPages",
          "attachments"
        ],
        "type": "object",
        "properties": {
          "element": {
            "$ref": "#/components/schemas/ElementDetails"
          },
          "markdown": {
            "type": "string"
          },
          "subPages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildPage"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentItem"
            }
          }
        }
      },
      "PathItem": {
        "required": [
          "id",
          "kind",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "kind": {
            "$ref": "#/components/schemas/ElementKind"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ProjectSummary": {
        "required": [
          "id",
          "name",
          "folder",
          "contentLanguage",
          "formatVersion",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "name": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "contentLanguage": {
            "type": "string"
          },
          "formatVersion": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectTree": {
        "required": [
          "nodes",
          "counts"
        ],
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TreeNodeItem"
            }
          },
          "counts": {
            "$ref": "#/components/schemas/RootCounts"
          }
        }
      },
      "RecentProjectItem": {
        "required": [
          "projectId",
          "name",
          "folder",
          "lastOpenedAt",
          "lastElementId",
          "status"
        ],
