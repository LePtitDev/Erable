<Project Sdk="Microsoft.NET.Sdk">

  <!-- erable-cli: read-only extraction of a project for other tools (docs/cli.md). -->
  <PropertyGroup>
    <!-- The version it shows comes from Git in a local build (Directory.Build.targets). -->
    <ErableVersionFromGit>true</ErableVersionFromGit>
    <OutputType>Exe</OutputType>
    <AssemblyName>erable-cli</AssemblyName>
    <RootNamespace>Erable.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erable.Core\Erable.Core.csproj" />
    <ProjectReference Include="..\Erable.Storage\Erable.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erable.Cli.Tests" />
  </ItemGroup>

</Project>
