<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The version it shows comes from Git in a local build (Directory.Build.targets). -->
    <ErableVersionFromGit>true</ErableVersionFromGit>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Erable.Desktop</RootNamespace>
    <!-- LibraryImport (user32: bring the window to the front, F16.R2) generates its marshalling as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PhotinoX" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Rendered from the in-app logo by src/web/scripts/generate-icons.mjs. -->
    <ApplicationIcon>Assets\erable.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icon at run time: .ico on Windows, .png elsewhere (PhotinoShell.IconFile). -->
    <None Include="Assets\erable.ico;Assets\erable.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erable.Server\Erable.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erable.Desktop.Tests" />
  </ItemGroup>

</Project>
