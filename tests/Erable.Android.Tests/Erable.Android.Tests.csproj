<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The logic of the Android shell without Android (decision Q11, docs/testing.md §10.1): the files of
    src/Erable.Android/Shell use no Android type and are compiled here as well, so that this project runs everywhere
    without the android workload.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Erable.Android\Shell\*.cs" Link="Shell\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Erable.Core\Erable.Core.csproj" />
  </ItemGroup>

</Project>
