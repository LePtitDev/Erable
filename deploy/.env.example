# Copy to deploy/.env. Never commit the real file.
ERABLE_DOMAIN=wiki.example.org
ERABLE_ADMIN_LOGIN=admin
ERABLE_ADMIN_PASSWORD=change-me-at-least-8-characters
# Optional
ERABLE_MAX_ATTACHMENT_MB=256
# Room for the attachments of one project, in MiB; 0 for none.
ERABLE_PROJECT_QUOTA_MB=0

# Continuous backup (docs/deployment.md §6), only with deploy/docker-compose.litestream.yml
# LITESTREAM_BUCKET=erable-backup
# LITESTREAM_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# LITESTREAM_REGION=eu-west-3
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_FORCE_PATH_STYLE=false
# FILES_BACKUP_INTERVAL_SECONDS=300
