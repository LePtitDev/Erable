# Certificates are requested and renewed by Caddy for the domain below (it must point to this machine,
# ports 80 and 443 open). WebSockets (SignalR) pass through reverse_proxy without any setting.
{$ERABLE_DOMAIN} {
	encode zstd gzip
	# HTTPS only for a year (the other security headers come from Erable itself).
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy erable:8080
}
